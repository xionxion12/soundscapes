{
  "name": "soundscapes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sleep soundscapes from xeno-canto recordings, as a mobile web app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audio:candidates": "node scripts/find-candidates.mjs",
    "audio:build": "node scripts/build-audio.mjs",
    "art": "node scripts/build-artwork.mjs",
    "audio:fades": "node scripts/build-fades.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0"
  }
}
